          },
          {
            "id": "sfarsit",
            "t": "Împăratul care se înalță și sfârșitul",
            "chapters": [
              5,
              10,
              11,
              12
            ],
            "sum": "Belșațar se înalță cu zeii lui și cade în aceeași noapte; împăratul din cap. 11 se înalță mai presus de orice dumnezeu și își va găsi sfârșitul. Scrisul de pe perete, apoi cartea adevărului."
          }
        ]
