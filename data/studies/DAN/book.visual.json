            ],
            "sum": "Statuia din visul împăratului și fiarele din viziunea lui Daniel: aceleași patru împărății, urmate de împărăția lui Dumnezeu (piatra, Fiul omului)."
          },
          {
            "id": "inchinare",
            "t": "Închinare impusă",
            "chapters": [
              3,
