    {
      "type": "book-map",
      "title": "Harta cărții Daniel",
      "note": "Două jumătăți: narațiuni la curțile imperiilor (cap. 1–6) și viziunile lui Daniel (cap. 7–12). Cartea este scrisă în ebraică, cu o secțiune în aramaică (2:4–7:28). Liniile arată capitolele care se explică unul pe altul.",
      "data": {
        "sections": [
          {
            "t": "Daniel la curțile imperiilor",
            "s": "cap. 1–6 · narațiuni",
            "from": 1,
            "to": 6
          },
          {
            "t": "Viziunile lui Daniel",
            "s": "cap. 7–12 · profeții",
            "from": 7,
            "to": 12
          }
        ],
        "bands": [
          {
            "t": "aramaică (2:4–7:28)",
            "from": 2,
            "to": 7
          }
        ],
        "chapters": {
          "1": {
            "t": "Exilul și testul hranei",
            "people": [
              "daniel",
              "hanania",
              "misael",
              "azaria",
              "nebucadnetar"
            ],
            "places": [
              "ierusalim",
              "babilon"
            ],
            "sum": "Nebucadnețar asediază Ierusalimul și duce în Babilon vase ale templului și tineri de neam ales. Daniel și prietenii lui refuză bucatele împăratului; după zece zile sunt mai sănătoși, iar Dumnezeu le dă înțelepciune."
          },
          "2": {
            "t": "Visul statuii",
            "people": [
              "daniel",
              "nebucadnetar",
              "arioc"
            ],
            "places": [
              "babilon"
            ],
            "sum": "Niciun înțelept nu poate spune visul împăratului. Daniel și prietenii se roagă, iar Dumnezeu i-l descoperă: o statuie din patru materiale, patru împărății, și o piatră care le sfărâmă și devine o împărăție veșnică."
          },
          "3": {
            "t": "Cuptorul aprins",
            "status": "în lucru",
            "people": [
              "hanania",
              "misael",
              "azaria",
              "nebucadnetar"
            ],
            "places": [
              "dura"
            ],
            "sum": "Nebucadnețar ridică un chip de aur în valea Dura. Șadrac, Meșac și Abed-Nego refuză să se închine și sunt aruncați în cuptorul aprins. Împăratul vede patru oameni umblând slobozi în foc și Îl binecuvântează pe Dumnezeul lor."
          },
          "4": {
            "t": "Copacul tăiat",
            "people": [
              "nebucadnetar",
              "daniel"
            ],
            "places": [
              "babilon"
            ],
            "sum": "Nebucadnețar visează un copac uriaș tăiat din hotărârea străjerilor cerești. Daniel îl tâlcuiește și îl cheamă la pocăință. Pentru mândria lui, împăratul trăiește șapte vremi printre fiare, apoi Îl recunoaște pe Cel Preaînalt."
          },
          "5": {
            "t": "Scrisul de pe perete",
            "people": [
              "belsatar",
              "daniel",
              "imparateasa",
              "dariu-medul"
            ],
            "places": [
              "babilon"
            ],
            "sum": "La ospățul lui Belșațar se bea din vasele templului. O mână scrie pe perete; Daniel citește judecata: împăratul a fost cântărit, iar împărăția lui va fi dată mezilor și perșilor. În aceeași noapte Babilonul cade."
          },
          "6": {
            "t": "Groapa cu lei",
            "people": [
              "daniel",
              "dariu-medul"
            ],
            "places": [
              "babilon",
              "ierusalim"
            ],
            "sum": "Dregătorii obțin de la Dariu o lege care interzice, timp de treizeci de zile, orice cerere adresată altcuiva decât împăratului. Daniel se roagă ca mai înainte și este aruncat în groapa cu lei, dar Dumnezeu le închide gura."
          },
          "7": {
            "t": "Fiarele și Fiul omului",
            "people": [
              "daniel",
              "cel-imbatranit",
              "fiul-omului",
              "belsatar"
            ],
            "places": [
              "babilon"
            ],
            "sum": "Patru fiare ies din mare: patru împărați. Cel Îmbătrânit de zile ține judecata, iar unul ca un fiu al omului vine pe norii cerurilor și primește o stăpânire veșnică. Cornul cel mic asuprește pe sfinți un timp."
          },
          "8": {
            "t": "Berbecul și țapul",
            "people": [
              "daniel",
              "gavril",
              "alexandru",
              "antioh-iv"
            ],
            "places": [
              "susa",
              "ulai"
            ],
            "sum": "La Susa, lângă râul Ulai, Daniel vede un berbec zdrobit de un țap venit din apus. Gavril tâlcuiește: mezii și perșii, apoi Grecia. Un corn mic oprește jertfa necurmată, dar va fi zdrobit fără mână omenească."
          },
          "9": {
            "t": "Rugăciunea și cele 70 de săptămâni",
            "people": [
              "daniel",
              "ieremia",
              "gavril",
              "dariu-medul"
            ],
            "places": [
              "ierusalim"
            ],
            "sum": "Citind din Ieremia despre cei șaptezeci de ani, Daniel mărturisește păcatul poporului și cere îndurare. Încă pe când se roagă, Gavril vine cu profeția celor șaptezeci de săptămâni: Ierusalimul rezidit, Unsul stârpit, urâciunea pustiirii."
          },
          "10": {
            "t": "Lupta nevăzută",
            "people": [
              "daniel",
              "mihail",
              "cir"
            ],
            "places": [
              "hidechel",
              "persia",
              "grecia"
            ],
            "sum": "După trei săptămâni de post, Daniel vede pe malul Tigrului un om îmbrăcat în in. Află că rugăciunea lui a fost ascultată din prima zi, dar căpetenia Persiei s-a împotrivit până a venit Mihail în ajutor."
          },
          "11": {
            "t": "Regii de la miazănoapte și de la miazăzi",
            "people": [
              "regele-miazanoapte",
              "regele-miazazi",
              "alexandru",
              "antioh-iv",
              "cei-intelepti"
            ],
            "places": [
              "persia",
              "grecia",
              "egipt",
              "ierusalim"
            ],
            "sum": "Profeția trece prin regii Persiei, prin Alexandru și prin războaiele dintre Siria și Egipt, până la Antioh IV, care spurcă Sfântul Locaș. Cei înțelepți învață pe mulți și sunt curățați prin suferință până la vremea sfârșitului."
          },
          "12": {
            "t": "Învierea și vremea sfârșitului",
            "people": [
              "mihail",
              "daniel",
              "cei-intelepti"
            ],
            "places": [],
            "sum": "Mihail se scoală într-o vreme de strâmtorare fără seamăn; cei scriși în carte vor fi mântuiți. Mulți din cei ce dorm se vor scula, unii pentru viața veșnică, alții pentru rușine. Daniel primește promisiunea învierii."
          }
        },
