      "data": {
        "idea": { "t": "Cei ce Îl cunosc pe Dumnezeu rămân tari", "text": "Profeția urmărește istoria în detaliu, până la Antioh IV. În mijlocul ei, poporul care Îl cunoaște pe Dumnezeu rămâne tare, iar suferința celor înțelepți are un scop: încercare, curățire, albire.", "refs": ["DAN 11:32", "DAN 11:35"] },
        "parts": [
          { "id": "a", "t": "Persia și Grecia", "refs": ["DAN 11:2-4"], "text": "Trei regi, apoi al patrulea, bogat; împăratul viteaz; împărăția ruptă în patru." },
          { "id": "b", "t": "Miazăzi și miazănoapte", "refs": ["DAN 11:5-20"], "text": "Războaiele Ptolemeilor și Seleucizilor; Rafia; Antioh III cel Mare." },
          { "id": "c", "t": "Omul disprețuit", "refs": ["DAN 11:21-35"], "text": "Antioh IV: uneltiri, campaniile în Egipt, corăbiile din Chitim, Sfântul Locaș spurcat, cei înțelepți." },
          { "id": "d", "t": "Împăratul care face ce vrea", "refs": ["DAN 11:36-45"], "text": "Se înalță mai presus de orice dumnezeu; ajunge la sfârșit fără ajutor." }
        ],
        "flow": [["a", "b", "împărăția împărțită"], ["b", "c", "în locul lui"], ["c", "d", "vremea sfârșitului"]],
