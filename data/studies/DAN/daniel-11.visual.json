          { "ch": 8, "from": "c", "t": "Cornul cel mic", "why": "Viziunea din cap. 8 prezenta deja pe Antioh IV ca un corn mic.", "refs": ["DAN 8:9", "DAN 8:11"] },
          { "ch": 10, "from": "a", "t": "Căpeteniile Persiei și Greciei", "why": "Istoria vizibilă a luptei nevăzute din cap. 10.", "refs": ["DAN 10:20"] },
          { "ch": 12, "from": "d", "t": "Vremea sfârșitului", "why": "Profeția continuă direct cu necazul cel mare și învierea.", "refs": ["DAN 12:1"] }
